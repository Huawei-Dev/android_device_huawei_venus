cc_library_shared {
    name: "liblogshim",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hwlog.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library {
    name: "libHWCamCfgSvr_shim",
    shared_libs: [
    	"libbinder", "libutils",
    ],
    srcs: [
        "IServiceManager.cpp",
    ],
    vendor: true
}

cc_library_shared {
    name: "libshim_memtrack",
    srcs: [
    	"memtrack_shim.cpp", "PermissionCache.cpp",
    ],
    shared_libs: [
    	"libhardware", "liblog", "libmemtrack", "libbinder", "libutils",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libcamera_metadata_helper",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "CameraMetadata.cpp", "Fence.cpp",
    ],
    cflags: [
        "-Werror",
        "-Wextra",
        "-Wall",
    ],
    shared_libs: [
        "liblog",
        "libui",
        "libutils",
        "libhardware",
        "libcamera_metadata",
    ],
    include_dirs: ["system/media/private/camera/include"],
}

cc_library_shared {
    name: "libcamera_algo_shim",
    srcs: [
    	"GraphicBufferMapper.cpp",
    	"memtrack_shim.cpp",
    ],
    shared_libs: [
        "libui",
        "libutils",
        "libhardware",
        "liblog",
        "libmemtrack",
    ],
    vendor_available: true,
}

cc_library_shared {
    name: "libhwcam_shim",
    srcs: [
    	"GraphicBuffer.cpp",
    	"GraphicBufferMapper.cpp",
    	"GraphicBufferMapper_hwcam.cpp",
    ],
    shared_libs: [
        "libui",
        "libutils",
        "libexif",
    ],
    vendor_available: true,
}

cc_library_shared {
    name: "libsensor_vendor",
    srcs: [
        "Sensor.cpp",
        "SensorEventQueue.cpp",
        "SensorManager.cpp",
    ],
    shared_libs: [
        "libsensorndkbridge",
        "libutils",
    ],
    vendor: true,
}
