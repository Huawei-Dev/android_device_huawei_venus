cc_library_shared {
    name: "libshim_memtrack",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "libshim_memtrack.cpp",
    ],
    shared_libs: [
        "liblog",
        "libhardware",
        "libmemtrack",        
    ],
    compile_multilib: "64",
}

cc_library_shared {
    name: "libcamera_metadata_helper",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "CameraMetadata.cpp",
    ],
    cflags: [
        "-Werror",
        "-Wextra",
        "-Wall",
    ],
    shared_libs: [
        "liblog",
        "libbinder",
        "libutils",
        "libhardware",
        "libcamera_metadata",
    ],
    include_dirs: [
        "system/media/private/camera/include",
    ],
    compile_multilib: "64",
}

cc_library_shared {
    name: "libgud",
    proprietary: true,
    shared_libs: [
        "libgui_vendor",
    ],
    compile_multilib: "64",
}

cc_library_shared {
    name: "libshim_hwcam",
    proprietary: true,
    srcs: ["camera_shim.cpp"],
    shared_libs: [
        "libui",
        "libexif",
    ],
    compile_multilib: "64",
}

cc_library_shared {
    name: "libshim_algo_hwcam",
    proprietary: true,
    srcs: ["graphic-buffer.cpp"],
    shared_libs: [
        "libui",
    ],
    compile_multilib: "64",
}
