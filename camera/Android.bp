    name: "libshim_memtrack",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "libshim_memtrack.cpp",
    ],
    shared_libs: [
        "liblog",
        "libhardware",
        "libmemtrack",        
