cc_library_shared {
    name: "liblogshim",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hwlog.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library {
    name: "libHWCamCfgSvr_shim",
    shared_libs: [
    	"libbinder", "libutils",
    ],
    srcs: [
        "IServiceManager.cpp",
    ],
    vendor: true
}

cc_library_shared {
    name: "libshim_memtrack",
    srcs: [
    	"memtrack_shim.cpp", "PermissionCache.cpp",
    ],
    shared_libs: [
    	"libhardware", "liblog", "libmemtrack", "libbinder", "libutils",
    ],
    vendor: true,
}
