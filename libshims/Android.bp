cc_library_shared {
    name: "liblog_vendor",
    srcs: ["libshim_log.cpp"],
    shared_libs: ["liblog"],
    vendor: true,
}

cc_library_shared {
    name: "android.hardware.radio@1.0_types",
    srcs: ["interfaces/radio/1.0/types.cpp"],
    shared_libs: ["android.hardware.radio@1.0"],
    system_ext_specific: true,
    vendor_available: true,
}

cc_library_shared {
    name: "android.hidl.base@1.0",
    shared_libs: ["libhidlbase"],
    system_ext_specific: true,
    vendor_available: true,
}

cc_library_shared {
    name: "libxcollie",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "xcollie.c",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libhwlog",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hwlog.c",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libchrlog",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "chrlog.c",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libhilog",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hilog.c",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libimonitor",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "cjson.c",
        "imonitor.c",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libshim_audioparams",
    srcs: ["libshim_audioparams.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
    ],
    vendor: true,
}
