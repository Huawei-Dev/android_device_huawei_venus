# Audio
ro.config.hw_music_lp=true
ro.config.music_lp_vol=true
ro.audio.offload_wakelock=false
ro.hardware.audio.primary=hisi_wrapper

# BT
ro.bt.bdaddr_path=/data/vendor/bluedroid/macbt
ro.rfkilldisabled=1

# Charger
ro.charger.disable_init_blank=true
ro.charger.enable_suspend=true

# Dex2oat
dalvik.vm.dex2oat64.enabled=true

# Display
ro.opengles.version=196610

# DRM
drm.service.enabled=true

# Fastbootd
ro.fastbootd.available=true

# Gralloc
ro.config.mmu_en=1
persist.smart_pool=1

# Kernel
ro.config.enable_rcc=true

# Media
persist.media.offload.enable=true
persist.media.lowlatency.enable=false
media.stagefright.thumbnail.prefer_hw_codecs=true
debug.stagefright.ccodec=0

# Misc
persist.sys.huawei.debug.on=1
ro.config.hw_vowifi=true

# Netflix
ro.netflix.bsp_rev=Q660-13149-1
    
# NFC
ro.hardware.nfc_nci=nqx.default
vendor.qti.nfc.chipid=0x51

# RIL
ro.config.ipv4.mtu=1400
net.tethering.noprovisioning=true
ro.config.hw_lte_support=true
gsm.fastdormancy.mode=1
    
# Sdcardfs
persist.sys.adoptable_fbe=true

# Sensors
ro.config.hw_sensorhub=true

# Skia
debug.hwui.renderer=skiagl
debug.renderengine.backend=threaded
renderthread.skia.reduceopstasksplitting=true

# SurfaceFlinger
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.running_without_sync_framework=true
debug.sf.disable_client_composition_cache=1
debug.sf.enable_gl_backpressure=1
service.sf.prime_shader_cache=0

# Touch
persist.sys.fingersense=1

# ZRAM
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=180
ro.zram.periodic_wb_delay_hours=24

# Zygote
zygote.critical_window.minute=10
